# KKMDM server settings. Copy to .env for local runs.
NODE_ENV=development
PORT=8100

# KKMDM's own database. Locally it shares the test mongod on 27018.
MONGODB_URI=mongodb://127.0.0.1:27018/kkmdm?replicaSet=rs0

# KnotKitchen's restaurant records (read-only) for store sync.
KNOTKITCHEN_MONGODB_URI=mongodb://127.0.0.1:27018/knotkitchen?replicaSet=rs0

# >= 32 chars each in production; generated per boot in development.
ADMIN_JWT_SECRET=
# Encrypts per-device technician OTP secrets at rest (32 bytes, base64).
DATA_ENCRYPTION_KEY=

# The URL devices use to reach this server (goes into the QR extras bundle).
PUBLIC_URL=http://localhost:8100

# HTTPS URL the setup wizard downloads the agent APK from, and its signing
# certificate checksum (SHA-256, base64url). Left blank, the server serves
# ./storage/agent/kk-agent.apk and computes the package checksum itself.
AGENT_APK_URL=
AGENT_SIGNATURE_CHECKSUM=

# First Super Admin, created on first boot if no admin exists.
SUPERADMIN_EMAIL=admin@knotkitchen.com
SUPERADMIN_PASSWORD=

# Dashboard origin(s) allowed by CORS, comma separated.
DASHBOARD_ORIGINS=http://localhost:5177

# Optional alert delivery.
ALERT_WEBHOOK_URL=
