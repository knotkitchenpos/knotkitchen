PORT=4000

# ============================================================
# DATABASE
# ============================================================
# IMPORTANT: This MUST be the exact same database as pos-backend/.env MONGODB_URI.
# The admin portal creates stores and the POS reads them from this shared database.
# If these differ, the POS will report "Invalid Store ID" for stores you just created.
MONGODB_URI=mongodb://localhost:27017/pos-db

# ============================================================
# SECRETS (required in production; app refuses to start without them)
# ============================================================
# Random string >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=

# ============================================================
# SEED SUPER ADMIN
# ============================================================
# ADMIN_EMAIL is the initial super-admin email.
# ADMIN_PASSWORD:
#   - Development: optional; defaults to "admin123" for convenience.
#   - Production:  REQUIRED, must be >= 12 chars and not a common default
#                  (admin, admin123, password, changeme, 123456, letmein).
# Set RESET_ADMIN_PASSWORD=true on a deployment run to rotate the existing
# admin password to the current ADMIN_PASSWORD value.
ADMIN_EMAIL=admin@knotkitchen.io
ADMIN_PASSWORD=

# ============================================================
# ENVIRONMENT
# ============================================================
NODE_ENV=development
ADMIN_TOKEN_EXPIRY=2h
# Comma-separated allow-list. NO wildcards. Do not include *.vercel.app or "*".
ADMIN_FRONTEND_ORIGIN=http://localhost:5174,http://localhost:5173

# ============================================================
# DEV-ONLY OTP BYPASS (§4). Ignored in production.
# ============================================================
ALLOW_DEV_OTP=false
OTP_DEV_CODE=123456

# Cookie SameSite mode in production ("none" for cross-site admin UI).
SAME_SITE_COOKIE=none
