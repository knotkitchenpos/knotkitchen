# Server
PORT=4000
NODE_ENV=development

# MongoDB - MUST point to the SAME database as the POS system so the portal
# can see every restaurant registered in the POS
MONGODB_URI=mongodb://localhost:27017/pos-db

# Admin auth
ADMIN_JWT_SECRET=change-this-to-a-long-random-secret
ADMIN_TOKEN_EXPIRY=2h

# Seed super admin (created automatically on first start)
ADMIN_EMAIL=admin@knotkitchen.io
ADMIN_PASSWORD=admin123

# CORS origin for the admin frontend in production
ADMIN_FRONTEND_ORIGIN=http://localhost:5173