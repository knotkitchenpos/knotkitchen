# =============================================================================
# Knot Kitchen — Customer Website
# =============================================================================
# All variables are baked into the client bundle at build time — never put a
# secret here. Only public URLs / feature flags belong in this file.

# Backend API base URL. In production this is the *.knotkitchen.com API host
# behind Cloudflare. In local dev it should be http://localhost:8000 so Vite
# can proxy to the POS backend.
VITE_BACKEND_URL=http://localhost:8000

# The apex domain the platform is served under. This is what tells the
# hostname resolver which host segment is the store slug:
#   burger-house.knotkitchen.com   +   VITE_BASE_DOMAIN=knotkitchen.com
#     => slug = "burger-house"
# Comma-separated. Include local dev domains so subdomain-based dev works too.
VITE_BASE_DOMAIN=knotkitchen.com,localhost

# Optional: fallback slug used when the browser hostname is a bare apex domain
# (someone visits knotkitchen.com directly) or an IP address. Leave empty to
# show a "not found" page in that case.
VITE_FALLBACK_SLUG=

# Optional: show a debug bar with the resolved store info (never enable in prod).
VITE_DEBUG_RESOLVER=false
