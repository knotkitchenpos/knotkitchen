<?xml version="1.0" encoding="utf-8"?>
<!--
  Both layers are full 108 dp squares. The foreground PNGs already keep the
  logo inside the 66 dp safe zone, so no inset: the old 16.7% inset squeezed an
  edge-to-edge logo into the visible area and the launcher mask crowded it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
