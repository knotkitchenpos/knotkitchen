node_modules
.env
.env.local
.env.*.local

# Log files (may contain OTPs, phone numbers, request bodies).
# See middlewares/globalErrorHandler + services/otpService — logging is
# deliberately reduced but backup log files must never be committed.
*.log

# Locally-stored media library files (MEDIA_STORAGE_PROVIDER=local).
# Production uses object storage, so these must never be committed.
uploads/

# Restaurant compliance documents — GST certificates, FSSAI licences,
# PAN/KYC scans, signed agreements. A local run writes real customer records
# here, so this must never reach the repository under any circumstances.
csd-documents/
