PORT=8000
MONGODB_URI=
JWT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FAST2SMS_API_KEY=

# ============================================================
# STOREFRONT (customer website)
# ============================================================
# Public base URL of the storefront app. Used to build the shareable
# website link shown in POS -> Website.
STOREFRONT_BASE_URL=http://localhost:5173
# Optional. Set to enable per-store subdomains later
# (e.g. abc-restaurant.knotkitchen.com). Leave blank for /store/:slug URLs.
STOREFRONT_ROOT_DOMAIN=

# Realtime + CORS origins (comma separated)
FRONTEND_URLS=http://localhost:5173
SOCKET_ENABLED=true
# Local development defaults. For a production APK/PWA calling the API from
# another origin, use COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Public storefront rate limits
STOREFRONT_ORDER_RATE_MAX=10
STOREFRONT_ORDER_RATE_WINDOW_MS=600000
STOREFRONT_READ_RATE_MAX=300
STOREFRONT_READ_RATE_WINDOW_MS=60000

# ============================================================
# MEDIA STORAGE
# ============================================================
# local | cloudinary | s3 | r2
# "local" works with zero extra configuration (files are written to
# pos-backend/uploads and served from /uploads).
MEDIA_STORAGE_PROVIDER=local

# --- local provider ---
# Public URL the backend serves uploads from. In production this should be
# your API's public origin, e.g. https://api.knotkitchen.com/uploads
BACKEND_PUBLIC_URL=http://localhost:8000
# MEDIA_PUBLIC_BASE_URL=http://localhost:8000/uploads
# UPLOADS_DIR=

# --- cloudinary (npm install cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- s3 / cloudflare r2 / supabase (npm install @aws-sdk/client-s3) ---
S3_BUCKET=
S3_REGION=auto
# Required for R2/Supabase/MinIO; leave blank for AWS S3
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# CDN / public bucket URL
S3_PUBLIC_BASE_URL=
