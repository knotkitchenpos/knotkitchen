PORT=8000
MONGODB_URI=

# ============================================================
# SECRETS
# ============================================================
# REQUIRED in production. Must be a random string of at least 32 characters.
# The app will refuse to start in production if these are missing/too short.
# Generate with, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# Optional token lifetimes
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# ============================================================
# PAYMENTS
# ============================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ============================================================
# SMS / OTP  (Fast2SMS is the SOLE production transport)
# ============================================================
# Fast2SMS is the only SMS gateway wired into services/otpService.js.
# In production this MUST be set — the process refuses to send an OTP if
# FAST2SMS_API_KEY is empty (a 502 is returned to the client instead of
# silently accepting the OTP request).
#
# In development, if it is empty, the OTP is printed to server logs so you
# can still complete the login flow without hitting the paid provider.
FAST2SMS_API_KEY=

# Fast2SMS route: "otp" for pre-approved OTP templates (recommended for OTPs),
# "v3" for transactional, "q" for promotional. Default is "otp".
FAST2SMS_ROUTE=otp

# Development-only OTP bypass (§4). Set to true + choose an OTP_DEV_CODE
# to skip the SMS provider in local dev. IGNORED in production.
ALLOW_DEV_OTP=false
OTP_DEV_CODE=123456

# Same idea for Product IDs: dev-only shortcut to auto-create "KK-..." ids.
# Never enabled in production.
ALLOW_DEMO_PRODUCT_ID=false

# ============================================================
# STOREFRONT (customer website)
# ============================================================
STOREFRONT_BASE_URL=http://localhost:5173
STOREFRONT_ROOT_DOMAIN=

# ============================================================
# CORS / cookies
# ============================================================
# Comma-separated list. Only these origins may call the API with credentials.
# Do NOT set this to a wildcard. Capacitor origins are always allowed.
FRONTEND_URLS=http://localhost:5173

# Wildcard base domains that host per-store customer websites.
# Any https://<slug>.<base> origin will be accepted by CORS.
# In production this should be your apex domain, e.g. knotkitchen.com.
# Leave blank in local dev; the customer-web dev server is already covered by
# FRONTEND_URLS above.
CORS_WILDCARD_DOMAINS=

# The apex domain the platform is deployed under. Used by the storefront
# provisioner to construct subdomain URLs for newly-created stores.
BASE_DOMAIN=

# Frontend URL used to construct QR / receipt / payment link URLs.
FRONTEND_URL=http://localhost:5173

SOCKET_ENABLED=true
# Local development defaults. For a production APK/PWA calling the API from
# another origin, use COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ============================================================
# RATE LIMITING
# ============================================================
# Storefront (public) limits
STOREFRONT_ORDER_RATE_MAX=10
STOREFRONT_ORDER_RATE_WINDOW_MS=600000
STOREFRONT_READ_RATE_MAX=300
STOREFRONT_READ_RATE_WINDOW_MS=60000

# Auth-specific limits (§13)
AUTH_LOGIN_RATE_MAX=10
AUTH_LOGIN_RATE_WINDOW_MS=900000
AUTH_OTP_SEND_RATE_MAX=5
AUTH_OTP_SEND_RATE_WINDOW_MS=900000
AUTH_OTP_VERIFY_RATE_MAX=10
AUTH_OTP_VERIFY_RATE_WINDOW_MS=900000

# Account lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MS=900000

# ============================================================
# MEDIA STORAGE
# ============================================================
# local | cloudinary | s3 | r2
MEDIA_STORAGE_PROVIDER=local
BACKEND_PUBLIC_URL=http://localhost:8000
# MEDIA_PUBLIC_BASE_URL=http://localhost:8000/uploads
# UPLOADS_DIR=

# --- cloudinary (npm install cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- s3 / cloudflare r2 / supabase (npm install @aws-sdk/client-s3) ---
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
