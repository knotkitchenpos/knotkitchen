# =============================================================================
# Knot Kitchen — Caddy reverse proxy (Cloudflare DNS-only, no proxying)
# =============================================================================
# Every named hostname still gets its cert the standard way (HTTP-01). Only
# the *.knotkitchen.online wildcard vhost below uses DNS-01 (via the
# caddy-dns/cloudflare plugin baked into this image) — a wildcard cert can
# never be issued over HTTP-01. DNS is hosted on Cloudflare in "DNS only"
# (grey cloud) mode, so traffic never actually passes through Cloudflare's
# edge — Caddy on this VPS still terminates TLS directly, same as before.
#
# Every internal upstream is addressed by its Docker service name on the
# `knot` network — Docker's embedded DNS resolves the correct container.
#
# Public hostname map (BASE_DOMAIN = knotkitchen.online):
#   knotkitchen.online            → customer-web  (landing / storefront)
#   csd.knotkitchen.online        → customer-web  (customer-facing storefront)
#   business.knotkitchen.online   → pos-web       (POS SPA)
#   onboard.knotkitchen.online    → admin-web     (super-admin / onboarding SPA)
#   api.knotkitchen.online        → pos-api       (POS backend API)
#   admin-api.knotkitchen.online  → admin-api     (super-admin backend API)
#   agreement.knotkitchen.online  → onboard-portal (partner onboarding)
#   <store_id>.knotkitchen.online → customer-web  (per-store storefront)

{
	email {$ACME_EMAIL}
}

# -----------------------------------------------------------------------------
# Shared security headers.
# -----------------------------------------------------------------------------
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "strict-origin-when-cross-origin"
		Permissions-Policy        "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
		-X-Powered-By
	}
}

# =============================================================================
# api.knotkitchen.online — POS backend
# =============================================================================
api.{$BASE_DOMAIN} {
	import security_headers

	request_body {
		max_size 12MB
	}

	reverse_proxy pos-api:8000 {
		header_up X-Real-IP           {remote_host}
		header_up X-Forwarded-For     {remote_host}
		header_up X-Forwarded-Proto   {scheme}
		header_up X-Forwarded-Host    {host}

		health_uri     /health
		health_interval 15s
		health_timeout  5s

		transport http {
			read_timeout  60s
			write_timeout 60s
		}
	}
}

# =============================================================================
# admin-api.knotkitchen.online — Super-admin backend
# =============================================================================
admin-api.{$BASE_DOMAIN} {
	import security_headers

	request_body {
		max_size 2MB
	}

	reverse_proxy admin-api:4000 {
		header_up X-Real-IP           {remote_host}
		header_up X-Forwarded-For     {remote_host}
		header_up X-Forwarded-Proto   {scheme}
		header_up X-Forwarded-Host    {host}

		health_uri     /health
		health_interval 15s
	}
}

# =============================================================================
# business.knotkitchen.online — POS SPA
# =============================================================================
# NOTE: `onboard.${BASE_DOMAIN}` was removed on 2026-08-30 along with the
# admin-web/admin-api services. The CSD panel at csd.${BASE_DOMAIN} took over
# that surface. Also delete the `onboard` A record from Cloudflare — a stale
# DNS entry would still be presented a cert here on renewal and 502 forever.
# =============================================================================
business.{$BASE_DOMAIN} {
	import security_headers

	encode zstd gzip
	reverse_proxy pos-web:80 {
		header_up Host {host}
	}
}

# =============================================================================
# csd.knotkitchen.online — Customer Support Desk (internal staff tool)
#
# Previously an alias for the landing page. It now serves the CSD panel, so
# the apex below no longer lists it.
# =============================================================================
csd.{$BASE_DOMAIN} {
	import security_headers

	encode zstd gzip
	reverse_proxy csd-web:80 {
		header_up Host {host}
	}
}

# =============================================================================
# knotkitchen.online — Landing page & Storefront
# =============================================================================
{$BASE_DOMAIN} {
	import security_headers

	encode zstd gzip

	# Static marketing landing page + legal pages, served straight off disk
	# from ./landing (bind-mounted into this container at /srv/landing).
	root * /srv/landing
	file_server

	# Anything the landing site does not have falls through to customer-web,
	# which still owns the apex storefront routes.
	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			reverse_proxy customer-web:80 {
				header_up Host {host}
			}
		}
	}
}

# =============================================================================
# agreement.knotkitchen.online — Partner Onboarding & Agreement portal
# =============================================================================
agreement.{$BASE_DOMAIN} {
	import security_headers

	request_body {
		max_size 20MB
	}

	encode zstd gzip
	reverse_proxy onboard-portal:3000 {
		header_up X-Real-IP           {remote_host}
		header_up X-Forwarded-For     {remote_host}
		header_up X-Forwarded-Proto   {scheme}
		header_up X-Forwarded-Host    {host}

		health_uri     /api/health
		health_interval 15s
	}
}

# =============================================================================
# <store_id>.knotkitchen.online — Per-store customer website
# =============================================================================
# Catch-all for any subdomain not matched by a vhost above. Unlike the
# on_demand_tls attempt that broke TLS for every hostname on this server, this
# uses a single wildcard cert obtained proactively via DNS-01 (see the `dns
# cloudflare` block below) — no per-request cert logic, no "ask" endpoint, no
# way for a handshake to hit an unissued cert.
*.{$BASE_DOMAIN} {
	import security_headers
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	encode zstd gzip
	reverse_proxy customer-web:80 {
		header_up Host {host}
	}
}
