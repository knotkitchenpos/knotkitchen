# =============================================================================
# Knot Kitchen — Caddy reverse proxy (Cloudflare DNS-only, no proxying)
# =============================================================================
# Every named hostname still gets its cert the standard way (HTTP-01). Only
# the *.knotkitchen.online wildcard vhost below uses DNS-01 (via the
# caddy-dns/cloudflare plugin baked into this image) — a wildcard cert can
# never be issued over HTTP-01. DNS is hosted on Cloudflare in "DNS only"
# (grey cloud) mode, so traffic never actually passes through Cloudflare's
# edge — Caddy on this VPS still terminates TLS directly, same as before.
#
# Every internal upstream is addressed by its Docker service name on the
# `knot` network — Docker's embedded DNS resolves the correct container.
#
# Public hostname map (BASE_DOMAIN = knotkitchen.online):
#   knotkitchen.online            → customer-web  (landing / storefront)
#   csd.knotkitchen.online        → customer-web  (customer-facing storefront)
#   business.knotkitchen.online   → pos-web       (POS SPA)
#   onboard.knotkitchen.online    → admin-web     (super-admin / onboarding SPA)
#   api.knotkitchen.online        → pos-api       (POS backend API)
#   admin-api.knotkitchen.online  → admin-api     (super-admin backend API)
#   agreement.knotkitchen.online  → onboard-portal (partner onboarding)
#   bill.knotkitchen.online       → pos-api       (customer bill link, /r/<token>)
#   order.knotkitchen.online      → pos-web       (table QR link, /t/<token>)
#   demostore.knotkitchen.online  → static        (Food Peddler sales demo)
#   <store_id>.knotkitchen.online → customer-web  (per-store storefront)

{
	email {$ACME_EMAIL}
}

# -----------------------------------------------------------------------------
# Shared security headers.
# -----------------------------------------------------------------------------
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "strict-origin-when-cross-origin"
		Permissions-Policy        "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
		-X-Powered-By
	}
}

# =============================================================================
# api.knotkitchen.online — POS backend
# =============================================================================
api.{$BASE_DOMAIN} {
	import security_headers

	request_body {
		max_size 12MB
	}

	reverse_proxy pos-api:8000 {
		header_up X-Real-IP           {remote_host}
		header_up X-Forwarded-For     {remote_host}
		header_up X-Forwarded-Proto   {scheme}
		header_up X-Forwarded-Host    {host}

		health_uri     /health
		health_interval 15s
		health_timeout  5s

		transport http {
			read_timeout  60s
			write_timeout 60s
		}
	}
}

# =============================================================================
# admin-api.knotkitchen.online — Super-admin backend
# =============================================================================
admin-api.{$BASE_DOMAIN} {
	import security_headers

	request_body {
		max_size 2MB
	}

	reverse_proxy admin-api:4000 {
		header_up X-Real-IP           {remote_host}
		header_up X-Forwarded-For     {remote_host}
		header_up X-Forwarded-Proto   {scheme}
		header_up X-Forwarded-Host    {host}

		health_uri     /health
		health_interval 15s
	}
}

# =============================================================================
# business.knotkitchen.online — POS SPA
# =============================================================================
# NOTE: `onboard.${BASE_DOMAIN}` was removed on 2026-08-30 along with the
# admin-web/admin-api services. The CSD panel at csd.${BASE_DOMAIN} took over
# that surface. Also delete the `onboard` A record from Cloudflare — a stale
# DNS entry would still be presented a cert here on renewal and 502 forever.
# =============================================================================
business.{$BASE_DOMAIN} {
	import security_headers

	encode zstd gzip
	reverse_proxy pos-web:80 {
		header_up Host {host}
	}
}

# =============================================================================
# csd.knotkitchen.online — Customer Support Desk (internal staff tool)
#
# Previously an alias for the landing page. It now serves the CSD panel, so
# the apex below no longer lists it.
# =============================================================================
csd.{$BASE_DOMAIN} {
	import security_headers

	encode zstd gzip
	reverse_proxy csd-web:80 {
		header_up Host {host}
	}
}

# =============================================================================
# bill.knotkitchen — the customer's bill link
# =============================================================================
# A vanity host in front of a route that already existed. The e-bill URL is the
# whole message when it arrives over WhatsApp or SMS, and
# `api.<base>/r/o_65f4..._Xy9` announces an API to a diner and spends
# characters on a path segment that means nothing to them.
#
# The rewrite is here rather than in the app so the OLD form keeps working: the
# `/r/<token>` route on pos-api is untouched, and every bill link already sent
# is sitting in a customer's message history where it can never be reissued.
#
# The pattern is the token shape receiptLink.js mints -- kind, 24-hex id,
# 22-char signature. Anything else falls through to pos-api unrewritten, so a
# health check or a typo gets an honest 404 rather than a mangled path.
bill.{$BASE_DOMAIN} {
	import security_headers

	encode zstd gzip

	@token path_regexp tok ^/([ois]_[0-9a-fA-F]{24}_[A-Za-z0-9_-]{22})$
	rewrite @token /r/{re.tok.1}

	reverse_proxy pos-api:8000 {
		header_up X-Real-IP           {remote_host}
		header_up X-Forwarded-For     {remote_host}
		header_up X-Forwarded-Proto   {scheme}
		header_up X-Forwarded-Host    {host}

		health_uri     /health
		health_interval 15s
		health_timeout  5s
	}
}

# =============================================================================
# order.knotkitchen — the link inside a table's QR code
# =============================================================================
# Same trick, same reason, and it matters more here: this URL IS the QR code.
# Once a card is printed and glued to a table it can never be edited, so the
# shorter the string the fewer modules the code needs and the more reliably a
# phone reads it across a dim table.
#
# `/t/<token>` on pos-web is untouched, so every card already printed under
# `business.<base>/t/<token>` keeps scanning.
#
# The pattern is the 64-hex token tableQRController mints. A single-segment
# path only, so nothing here can shadow the SPA's /assets/* bundle requests.
order.{$BASE_DOMAIN} {
	import security_headers

	encode zstd gzip

	@qr path_regexp qtok ^/([0-9a-f]{64})$
	rewrite @qr /t/{re.qtok.1}

	reverse_proxy pos-web:80 {
		header_up Host {host}
	}
}

# =============================================================================
# knotkitchen.online — Landing page & Storefront
# =============================================================================
{$BASE_DOMAIN} {
	import security_headers

	encode zstd gzip

	# Static marketing landing page + legal pages, served straight off disk
	# from ./landing (bind-mounted into this container at /srv/landing).
	root * /srv/landing
	file_server

	# Anything the landing site does not have falls through to customer-web,
	# which still owns the apex storefront routes.
	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			reverse_proxy customer-web:80 {
				header_up Host {host}
			}
		}
	}
}

# =============================================================================
# agreement.knotkitchen.online — Partner Onboarding & Agreement portal
# =============================================================================
agreement.{$BASE_DOMAIN} {
	import security_headers

	request_body {
		max_size 20MB
	}

	encode zstd gzip
	reverse_proxy onboard-portal:3000 {
		header_up X-Real-IP           {remote_host}
		header_up X-Forwarded-For     {remote_host}
		header_up X-Forwarded-Proto   {scheme}
		header_up X-Forwarded-Host    {host}

		health_uri     /api/health
		health_interval 15s
	}
}

# =============================================================================
# demostore.knotkitchen.online — Food Peddler static preview
# =============================================================================
# A sales demo: a fixed storefront page served straight off disk, with no
# backend and no store record behind it.
#
# This lived only on the VPS for three days, hand-edited into the deployed
# Caddyfile. That is what made `git pull --ff-only` refuse to fast-forward, and
# because the deploy step ended in `|| true` the job reported success while
# running the previous commit -- every deploy between 2026-09-07 and now was a
# silent no-op. It is in version control so that cannot happen again.
#
# Declared BEFORE the wildcard below, or that catch-all takes the hostname and
# proxies it to customer-web, which has no such store.
demostore.{$BASE_DOMAIN} {
	import security_headers

	encode zstd gzip

	root * /srv/landing/demostore
	file_server
}

# =============================================================================
# <store_id>.knotkitchen.online — Per-store customer website
# =============================================================================
# Catch-all for any subdomain not matched by a vhost above. Unlike the
# on_demand_tls attempt that broke TLS for every hostname on this server, this
# uses a single wildcard cert obtained proactively via DNS-01 (see the `dns
# cloudflare` block below) — no per-request cert logic, no "ask" endpoint, no
# way for a handshake to hit an unissued cert.
*.{$BASE_DOMAIN} {
	import security_headers
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	encode zstd gzip
	reverse_proxy customer-web:80 {
		header_up Host {host}
	}
}
