# =============================================================================
# Knot Kitchen — Caddy reverse proxy
# =============================================================================
# Standard automatic HTTPS via Let's Encrypt / ZeroSSL HTTP-01 challenge.
# Every internal upstream is addressed by its Docker service name on the `knot`
# network — Docker's embedded DNS resolves the correct container.

{
	email {$ACME_EMAIL}
}

# -----------------------------------------------------------------------------
# Certificate snippet
# -----------------------------------------------------------------------------
(wildcard_cert) {
}

# -----------------------------------------------------------------------------
# Shared security headers.
# -----------------------------------------------------------------------------
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "strict-origin-when-cross-origin"
		Permissions-Policy        "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
		-X-Powered-By
	}
}

# =============================================================================
# api.knotkitchen.online — POS backend
# =============================================================================
api.{$BASE_DOMAIN} {
	import security_headers

	request_body {
		max_size 12MB
	}

	reverse_proxy pos-api:8000 {
		header_up X-Real-IP           {remote_host}
		header_up X-Forwarded-For     {remote_host}
		header_up X-Forwarded-Proto   {scheme}
		header_up X-Forwarded-Host    {host}

		health_uri     /health
		health_interval 15s
		health_timeout  5s

		transport http {
			read_timeout  60s
			write_timeout 60s
		}
	}
}

# =============================================================================
# admin-api.knotkitchen.online — Super-admin backend
# =============================================================================
admin-api.{$BASE_DOMAIN} {
	import security_headers

	request_body {
		max_size 2MB
	}

	reverse_proxy admin-api:4000 {
		header_up X-Real-IP           {remote_host}
		header_up X-Forwarded-For     {remote_host}
		header_up X-Forwarded-Proto   {scheme}
		header_up X-Forwarded-Host    {host}

		health_uri     /health
		health_interval 15s
	}
}

# =============================================================================
# admin.knotkitchen.online / onboard.knotkitchen.online — Super-admin & Onboarding SPA
# =============================================================================
admin.{$BASE_DOMAIN}, onboard.{$BASE_DOMAIN} {
	import security_headers

	encode zstd gzip
	reverse_proxy admin-web:80 {
		header_up Host {host}
	}
}

# =============================================================================
# pos.knotkitchen.online / business.knotkitchen.online — POS SPA
# =============================================================================
pos.{$BASE_DOMAIN}, business.{$BASE_DOMAIN} {
	import security_headers

	encode zstd gzip
	reverse_proxy pos-web:80 {
		header_up Host {host}
	}
}

# =============================================================================
# app.knotkitchen.online — same as POS
# =============================================================================
app.{$BASE_DOMAIN} {
	import security_headers

	encode zstd gzip
	reverse_proxy pos-web:80 {
		header_up Host {host}
	}
}

# =============================================================================
# knotkitchen.online / csd.knotkitchen.online — Landing Page & Storefront
# =============================================================================
csd.{$BASE_DOMAIN}, {$BASE_DOMAIN} {
	import security_headers

	encode zstd gzip
	reverse_proxy customer-web:80 {
		header_up Host {host}
	}
}
