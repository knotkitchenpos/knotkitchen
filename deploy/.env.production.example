# =============================================================================
# Knot Kitchen — production environment
# =============================================================================
# Copy to `deploy/.env` on the VPS. NEVER commit this file with real values.
# The compose file (docker-compose.yml) is the only consumer; it forwards
# these into the appropriate containers.
#
# Generate strong secrets (min 48 hex chars) with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# -----------------------------------------------------------------------------
# Domain
# -----------------------------------------------------------------------------
# The apex domain the platform is served under. Every subdomain (admin, pos,
# api, admin-api, <store-slug>) is derived from this — do NOT include the
# leading dot.
BASE_DOMAIN=knotkitchen.com

# Cloudflare API token with `Zone:DNS:Edit` on the BASE_DOMAIN zone. Used by
# Caddy to prove ownership for the wildcard cert via DNS-01.
CLOUDFLARE_API_TOKEN=

# The email address Let's Encrypt / ZeroSSL will send expiry warnings to.
ACME_EMAIL=ops@knotkitchen.com

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
# Atlas SRV URI. IP-allowlist the VPS in the Atlas Network Access panel.
MONGODB_URI=mongodb+srv://USER:PASS@cluster-xxxx.mongodb.net/knotkitchen?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# JWT / session secrets
# -----------------------------------------------------------------------------
# One secret per app. The admin secret is DELIBERATELY different from the POS
# secret so a leak of one cannot forge sessions for the other.
JWT_SECRET=REPLACE_ME_AT_LEAST_48_HEX_CHARACTERS
REFRESH_TOKEN_SECRET=REPLACE_ME_AT_LEAST_48_HEX_CHARACTERS
ADMIN_JWT_SECRET=REPLACE_ME_AT_LEAST_48_HEX_CHARACTERS
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# -----------------------------------------------------------------------------
# Super-admin bootstrap account (seeded on first admin-api start)
# -----------------------------------------------------------------------------
SUPERADMIN_EMAIL=admin@knotkitchen.com
SUPERADMIN_PASSWORD=REPLACE_ME_LONG_RANDOM_PASSPHRASE

# -----------------------------------------------------------------------------
# Object storage (Cloudflare R2 = S3-compatible)
# -----------------------------------------------------------------------------
MEDIA_STORAGE_PROVIDER=r2
S3_BUCKET=knotkitchen-media
S3_REGION=auto
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for served media (custom R2 domain or the R2 public URL).
S3_PUBLIC_BASE_URL=https://media.knotkitchen.com
MEDIA_PUBLIC_BASE_URL=https://media.knotkitchen.com

# -----------------------------------------------------------------------------
# Payments (optional)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# SMS OTP — Fast2SMS is the SOLE production transport.
# -----------------------------------------------------------------------------
# REQUIRED in production. When this is empty the API refuses to send OTPs
# (returns HTTP 502 to the client) rather than silently accepting the request.
# Rotate the key in Fast2SMS dashboard and paste the new one here, then run:
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d pos-api
FAST2SMS_API_KEY=
# Fast2SMS route: "otp" (default, recommended for OTP templates), "v3", or "q".
FAST2SMS_ROUTE=otp

# -----------------------------------------------------------------------------
# Customer website fallback
# -----------------------------------------------------------------------------
# If someone visits knotkitchen.com directly (no subdomain), render this slug.
# Leave empty to show the generic "pick a restaurant" landing page.
VITE_FALLBACK_SLUG=
