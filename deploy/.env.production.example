# =============================================================================
# Knot Kitchen — production environment (Hostinger VPS, no Cloudflare)
# =============================================================================
# Copy to `deploy/.env` on the VPS. NEVER commit this file with real values.
# The compose file (docker-compose.yml) is the only consumer; it forwards
# these into the appropriate containers.
#
# Generate strong secrets (min 48 hex chars) with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# -----------------------------------------------------------------------------
# Domain & Hostinger VPS
# -----------------------------------------------------------------------------
# Public IPv4 of the Hostinger KVM VPS that runs this stack:  93.127.194.80
# Every A record in the Hostinger DNS Zone (@, www, csd, business, api,
# agreement) MUST point at that IP. No CDN/proxy in front — Caddy on the VPS
# terminates TLS directly via Let's Encrypt HTTP-01.
#
# The apex domain the platform is served under. Every subdomain (business,
# csd, api, agreement, ...) is derived from this — do NOT include the leading
# dot.
BASE_DOMAIN=knotkitchen.com

# The email address Let's Encrypt / ZeroSSL will send expiry warnings to.
# Caddy uses HTTP-01 over port 80 to obtain and renew every certificate —
# no DNS provider API token is required.
ACME_EMAIL=ops@knotkitchen.com

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
# Recommended: MongoDB Atlas SRV URI. IP-allowlist the VPS in the Atlas
# Network Access panel. Alternatively use the self-hosted `mongo` compose
# service (see DEPLOYMENT.md).
MONGODB_URI=mongodb+srv://USER:PASS@cluster-xxxx.mongodb.net/knotkitchen?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# JWT / session secrets
# -----------------------------------------------------------------------------
# Signing secrets. Distinct per surface so a leak of one cannot forge
# sessions for the others. ADMIN_JWT_SECRET was removed when the admin-web /
# admin-api services were deleted (2026-08-30).
JWT_SECRET=REPLACE_ME_AT_LEAST_48_HEX_CHARACTERS
REFRESH_TOKEN_SECRET=REPLACE_ME_AT_LEAST_48_HEX_CHARACTERS
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# -----------------------------------------------------------------------------
# Super-admin bootstrap account
#
# Seeded into the CSD panel (csd.${BASE_DOMAIN}) on first pos-api start. Sign
# in with these credentials, then create the rest of your staff from Staff
# Management. To rotate this password later, set RESET_SUPERADMIN_PASSWORD=true
# with the new SUPERADMIN_PASSWORD and restart pos-api once — the flag is only
# read at startup, so remove it again after.
# -----------------------------------------------------------------------------
SUPERADMIN_EMAIL=admin@knotkitchen.com
SUPERADMIN_PASSWORD=REPLACE_ME_LONG_RANDOM_PASSPHRASE

# -----------------------------------------------------------------------------
# Object storage
# -----------------------------------------------------------------------------
# Provider selector consumed by pos-backend/services/storage/. Options:
#   local       — files live on the VPS in the backend_uploads Docker volume.
#                 Simplest, no external account. Fine up to a few GB.
#   s3          — AWS S3, Wasabi, Backblaze B2, DigitalOcean Spaces, MinIO...
#                 anything speaking the S3 API. Fill in the S3_* values below.
#   cloudinary  — Cloudinary image/video CDN. Fill in CLOUDINARY_* values.
MEDIA_STORAGE_PROVIDER=local

# When MEDIA_STORAGE_PROVIDER=local, this is the public URL under which the
# backend serves /uploads/*. Leave it as the API host — Caddy already routes
# it correctly.
MEDIA_PUBLIC_BASE_URL=https://api.knotkitchen.com/uploads

# -----------------------------------------------------------------------------
# Customer-facing short links
# -----------------------------------------------------------------------------
# The only two URLs a diner ever reads, so they get their own hosts rather than
# an API path: bill.<base>/<token> and order.<base>/<token>. Caddy rewrites
# each back onto the route that already served it (/r/<token> on pos-api,
# /t/<token> on pos-web), so every bill link already sent and every QR card
# already printed keeps working.
#
# Both default to bill.${BASE_DOMAIN} / order.${BASE_DOMAIN}. Leave them unset
# unless the short hosts live on a different domain from everything else.
RECEIPT_PUBLIC_URL=
QR_PUBLIC_URL=

# --- S3 / S3-compatible ----------------------------------------------------
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Cloudinary ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# SMS OTP — Fast2SMS is the SOLE production transport.
# -----------------------------------------------------------------------------
# REQUIRED in production. When this is empty the API refuses to send OTPs
# (returns HTTP 502 to the client) rather than silently accepting the request.
FAST2SMS_API_KEY=

# -----------------------------------------------------------------------------
# Customer website fallback
# -----------------------------------------------------------------------------
# If someone visits knotkitchen.com (or csd.knotkitchen.com) directly
# without a store slug, render this slug. Leave empty to show the generic
# "pick a restaurant" landing page.
VITE_FALLBACK_SLUG=

# -----------------------------------------------------------------------------
# Partner Onboarding & Agreement portal (agreement.knotkitchen.com)
# -----------------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ONBOARD_JWT_SECRET=REPLACE_ME_AT_LEAST_32_CHARS
# Only used to bootstrap an admin account if the onboard_data volume is empty.
ONBOARD_ADMIN_USERNAME=admin
ONBOARD_ADMIN_PASSWORD=REPLACE_ME_LONG_RANDOM_PASSPHRASE

# -----------------------------------------------------------------------------
# KnotKitchen Business — CSD + Admin panel (csd.${BASE_DOMAIN})
# -----------------------------------------------------------------------------
# Signs the CSD session cookie. MUST be different from JWT_SECRET so a CSD
# token can never authenticate a POS request. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# If this is unset, pos-api still boots normally and only /api/csd/* returns
# 503 — CSD is deliberately fail-closed rather than taking the POS API down.
CSD_JWT_SECRET=REPLACE_ME_AT_LEAST_32_CHARS

# The CSD panel is email + password. The bootstrap super-admin is seeded from
# SUPERADMIN_EMAIL / SUPERADMIN_PASSWORD above; further staff are added from
# Staff Management once you sign in. (Historically this was CSD_ADMIN_PHONES —
# removed when the panel migrated off phone + OTP on 2026-08-30.)

# How long a CSD session lasts before re-authentication. Role and account
# status are re-read from the database on every request, so disabling a staff
# member takes effect immediately regardless of this value.
CSD_TOKEN_EXPIRY=12h

# -----------------------------------------------------------------------------
# CSD ← onboarding portal (agreement → store creation)
# -----------------------------------------------------------------------------
# See docs/ONBOARD_PORTAL_INTEGRATION.md. The portal runs in the same compose
# project, so this is its service name — the traffic never leaves the host.
ONBOARD_BASE_URL=http://onboard-portal:3000

# Shared secret so pos-api can read agreements without an agent session. MUST
# match the value configured in the onboarding portal. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Leave this unset until the portal supports it: CSD then makes no calls at
# all and the Agreements page explains the setup step, rather than attempting
# unauthenticated requests against endpoints that return customer PII.
ONBOARD_SERVICE_TOKEN=

# -----------------------------------------------------------------------------
# Cloudflare (DNS-only — no proxying) — required only for the wildcard cert
# -----------------------------------------------------------------------------
# DNS for BASE_DOMAIN is hosted on Cloudflare in "DNS only" (grey cloud) mode;
# traffic never passes through Cloudflare's edge. This token is used solely by
# the caddy-dns/cloudflare plugin to obtain the *.${BASE_DOMAIN} wildcard cert
# via DNS-01 (a wildcard can never be issued over HTTP-01). Every other
# hostname's cert still uses plain HTTP-01 and never touches this token.
# Create at: Cloudflare dashboard → My Profile → API Tokens → Create Token →
# "Edit zone DNS" template, scoped to this one zone only.
CLOUDFLARE_API_TOKEN=REPLACE_ME_SCOPED_ZONE_DNS_EDIT_TOKEN
