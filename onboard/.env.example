# Copy to `.env` (never commit the real file — it's already gitignored).

PORT=3000
NODE_ENV=production

# Comma-separated list of origins allowed to call this API with credentials.
# Leave empty only for local dev.
ALLOWED_ORIGINS=https://agreement.knotkitchen.online

# Session signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AGENT_JWT_SECRET=REPLACE_ME_AT_LEAST_32_CHARS

# Used only to bootstrap the very first admin account if server/data/database.json
# does not exist yet. Ignored once the database file has been created.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_ME_LONG_RANDOM_PASSPHRASE
